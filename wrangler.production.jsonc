{
  "name": "hisan-portfolio",
  "main": "cloudflare/production-worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".vercel/site-static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/*"
    ]
  },
  "vars": {
    "NODE_ENV": "production",
    "ADMIN_ORIGIN": "https://hisanali.com",
    "ADMIN_EMAIL": "hisanali73@gmail.com",
    "GA4_PROPERTY_ID": "515896463"
  },
  "routes": [
    {
      "pattern": "hisanali.com/*",
      "zone_id": "c0278469c0aaf3301bfef4a03859a5e8"
    }
  ]
}
