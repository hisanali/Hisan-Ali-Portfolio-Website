{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:games": "esbuild games/tic-online.entry.js --bundle --minify --format=iife --target=es2020 --outfile=games/tic-online.bundle.js && esbuild games/multiplayer.entry.js --bundle --minify --format=iife --target=es2020 --outfile=games/multiplayer.bundle.js && esbuild games/snake3d.entry.js --bundle --minify --format=iife --target=es2020 --outfile=games/snake3d.bundle.js",
    "dev": "npm run build:games && next dev",
    "build": "npm run build:games && npm run build:cube && node scripts/generate-static-site.mjs && npm run seo:sitemap && npm run seo:audit && next build",
    "start": "next start",
    "lint": "next lint",
    "sync:footer": "node scripts/sync-footer.js",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:audit": "node scripts/audit-seo.mjs",
    "build:cube": "esbuild tools/rubiks-cube/studio.js --bundle --minify --format=iife --target=es2020 --outfile=tools/rubiks-cube/studio.bundle.js && esbuild tools/rubiks-cube/solver.worker.js --bundle --minify --format=iife --target=es2020 --outfile=tools/rubiks-cube/solver.bundle.js",
    "test:cube": "node scripts/test-cube.mjs",
    "test:cube-scan": "node scripts/test-cube-scan.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "clsx": "^2.0.0",
    "gray-matter": "^4.0.3",
    "marked": "^5.1.1",
    "next": "^14.0.0",
    "qrcode": "1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/marked": "^5.0.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.2",
    "autoprefixer": "^10.4.0",
    "esbuild": "0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^13.4.8",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.5",
    "typescript": "^5.5.0"
  }
}
